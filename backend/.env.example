# Copy to .env and edit. Never commit the real .env.
# Generate a secret:  python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
SECRET_KEY=
# DATABASE_URL=sqlite:////absolute/path/to/persistent/cipherchat.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Production only
# REQUIRE_HTTPS=true
# TRUSTED_PROXY_COUNT=1
# SOCKETIO_CORS_ORIGINS=
# RATELIMIT_STORAGE_URI=memory://

# Optional tuning
# LOGIN_RATE_LIMIT=10 per minute
# REGISTER_RATE_LIMIT=5 per minute
# SESSION_IDLE_TTL_SECONDS=1209600
# SESSION_ABSOLUTE_TTL_SECONDS=7776000
